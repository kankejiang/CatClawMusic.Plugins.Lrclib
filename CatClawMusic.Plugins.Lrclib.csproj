<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CatClawMusic.Plugins.Lrclib</RootNamespace>
    <AssemblyName>CatClawMusic.Plugins.Lrclib</AssemblyName>
    <!-- 版本号统一在此维护：三段为主版本（功能），第四段为小更新修订，每次小更新 +1 -->
    <Version>1.2.0.5</Version>
    <!-- 插件以独立 DLL 交付，不携带依赖（Core/MAUI 由宿主提供） -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- 注意：本项目位于 D:\Code\CatClawMusic.Plugins.Lrclib，CatClawMusic.Core 在其同级
         CatClawMusic\ 目录下，因此相对路径为 ..\CatClawMusic\CatClawMusic.Core -->
    <ProjectReference Include="..\CatClawMusic\CatClawMusic.Core\CatClawMusic.Core.csproj" />
    <!-- 手动匹配入口页（IViewContributorPlugin）：纯 C# 代码构建 UI，不用 XAML。
         版本与宿主一致（11.0.0-preview），CopyLocalLockFileAssemblies=false 保证不随插件分发。 -->
    <PackageReference Include="Microsoft.Maui.Controls" Version="11.0.0-preview.7.26406.9" />
    <!-- MVVM Toolkit：手动匹配页 ViewModel 使用 ObservableObject/RelayCommand -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Jint JS 引擎：运行 Lyrico 源插件 .js（多源歌词编排兜底）。
         以嵌入资源分发（不随插件输出 DLL），编译期用其 API；运行期由
         LyricoScriptEngineLoader 的 AssemblyResolve 从嵌入资源流加载 Jint.dll + Acornima.dll。
         Acornima 是 Jint 的解析器依赖，显式直接引用以拿到 PkgAcornima 路径属性。 -->
    <PackageReference Include="Jint" Version="4.16.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>Compile;Analyzers</IncludeAssets>
      <GeneratePathProperty>true</GeneratePathProperty>
    </PackageReference>
    <PackageReference Include="Acornima" Version="1.7.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>Compile;Analyzers</IncludeAssets>
      <GeneratePathProperty>true</GeneratePathProperty>
    </PackageReference>
  </ItemGroup>

  <!-- 把 Jint.dll / Acornima.dll 嵌入插件程序集资源（LogicalName 固定，运行期按名读取）。
       静态项在 eval 阶段求值，$(PkgJint)/$(PkgAcornima) 由 restore 生成的 .g.props 提供。
       net10.0 优先，回落 net8.0（net10 可加载 net8 程序集）。 -->
  <ItemGroup>
    <EmbeddedResource Include="$(PkgJint)\lib\net10.0\Jint.dll"
                     Condition="'$(PkgJint)' != '' And Exists('$(PkgJint)\lib\net10.0\Jint.dll')"
                     LogicalName="Jint.dll" />
    <EmbeddedResource Include="$(PkgJint)\lib\net8.0\Jint.dll"
                     Condition="'$(PkgJint)' != '' And !Exists('$(PkgJint)\lib\net10.0\Jint.dll') And Exists('$(PkgJint)\lib\net8.0\Jint.dll')"
                     LogicalName="Jint.dll" />
    <EmbeddedResource Include="$(PkgAcornima)\lib\net10.0\Acornima.dll"
                     Condition="'$(PkgAcornima)' != '' And Exists('$(PkgAcornima)\lib\net10.0\Acornima.dll')"
                     LogicalName="Acornima.dll" />
    <EmbeddedResource Include="$(PkgAcornima)\lib\net8.0\Acornima.dll"
                     Condition="'$(PkgAcornima)' != '' And !Exists('$(PkgAcornima)\lib\net10.0\Acornima.dll') And Exists('$(PkgAcornima)\lib\net8.0\Acornima.dll')"
                     LogicalName="Acornima.dll" />
  </ItemGroup>

  <ItemGroup>
    <!-- 发现页入口图标：PNG 嵌入 DLL，宿主经 res://Lrclib.entry-icon.png 按资源名后缀匹配加载。
         SVG 是源文件（iconfont 抓取，改色重渲染用），不参与打包。 -->
    <EmbeddedResource Include="Lrclib\Assets\entry-icon.png" LogicalName="Lrclib.entry-icon.png" />
    <None Include="Lrclib\Assets\entry-icon.svg" Pack="false" CopyToOutputDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <!-- 客户端只认 .ccp 插件包：构建后把程序集复制为 .ccp 作为发布产物 -->
    <None Include="$(TargetPath)" Pack="false" CopyToOutputDirectory="Never" />
  </ItemGroup>

  <Target Name="PackageCcp" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <Copy SourceFiles="$(TargetPath)"
          DestinationFiles="$(OutDir)CatClawMusic.Plugins.Lrclib.ccp"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
