<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CatClawMusic.Plugins.Lrclib</RootNamespace>
    <AssemblyName>CatClawMusic.Plugins.Lrclib</AssemblyName>
    <!-- 版本号统一在此维护：三段为主版本（功能），第四段为小更新修订，每次小更新 +1 -->
    <Version>1.2.0.7</Version>
    <!-- 插件以独立 DLL 交付，不携带依赖（Core/MAUI 由宿主提供） -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- 注意：本项目位于 D:\Code\CatClawMusic.Plugins.Lrclib，CatClawMusic.Core 在其同级
         CatClawMusic\ 目录下，因此相对路径为 ..\CatClawMusic\CatClawMusic.Core -->
    <ProjectReference Include="..\CatClawMusic\CatClawMusic.Core\CatClawMusic.Core.csproj" />
    <!-- 手动匹配入口页（IViewContributorPlugin）：纯 C# 代码构建 UI，不用 XAML。
         版本与宿主一致（11.0.0-preview），CopyLocalLockFileAssemblies=false 保证不随插件分发。 -->
    <PackageReference Include="Microsoft.Maui.Controls" Version="11.0.0-preview.7.26406.9" />
    <!-- MVVM Toolkit：手动匹配页 ViewModel 使用 ObservableObject/RelayCommand -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Jint JS 引擎：运行 Lyrico 源插件 .js（多源歌词编排兜底）。
         仅编译期引用 API（不随插件输出、不嵌入资源）；运行期由宿主统一提供
         （宿主 Core 的 Jint/Acornima 随 App 分发），经宿主 DI 的 IJsRuntimeService
         创建引擎。Acornima 是 Jint 的解析器依赖，显式引用以锁定版本。 -->
    <PackageReference Include="Jint" Version="4.16.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>Compile;Analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Acornima" Version="1.7.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>Compile;Analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- 发现页入口图标：PNG 嵌入 DLL，宿主经 res://Lrclib.entry-icon.png 按资源名后缀匹配加载。
         SVG 是源文件（iconfont 抓取，改色重渲染用），不参与打包。 -->
    <EmbeddedResource Include="Lrclib\Assets\entry-icon.png" LogicalName="Lrclib.entry-icon.png" />
    <None Include="Lrclib\Assets\entry-icon.svg" Pack="false" CopyToOutputDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <!-- 客户端只认 .ccp 插件包：构建后把程序集复制为 .ccp 作为发布产物 -->
    <None Include="$(TargetPath)" Pack="false" CopyToOutputDirectory="Never" />
  </ItemGroup>

  <Target Name="PackageCcp" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <Copy SourceFiles="$(TargetPath)"
          DestinationFiles="$(OutDir)CatClawMusic.Plugins.Lrclib.ccp"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
